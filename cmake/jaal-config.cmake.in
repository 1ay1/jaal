@PACKAGE_INIT@

# jaal links Threads::Threads publicly (the worker pool, the reactor waker),
# so a consumer of the installed package needs that target to exist before
# jaalTargets.cmake names it.
include(CMakeFindDependencyMacro)
find_dependency(Threads)

include("${CMAKE_CURRENT_LIST_DIR}/jaalTargets.cmake")
check_required_components(jaal)
